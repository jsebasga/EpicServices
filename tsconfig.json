{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
, ".next/types/app/(auth)/login/page.tsx", ".next/types/app/(auth)/recuperar-contrasena/page.tsx", ".next/types/app/dashboard/cliente/page.tsx", ".next/types/app/dashboard/cambiar-contrasena/page.tsx", ".next/types/app/(marketing)/page.tsx", ".next/types/app/(auth)/recuperar-contrasena/page.tsx", ".next/types/app/(auth)/login/page.tsx"  ],
  "exclude": [
    "node_modules"
  ]
}
